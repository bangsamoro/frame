# InstaFrame — static site served by Apache (Webuzo).
#
# The app is updated in place, and this server sends no Cache-Control and no
# ETag, so a browser is free to hold a stale build and keep showing the old
# behaviour after a deploy. Revalidate everything on every load; conditional
# requests still answer 304 from Last-Modified, so this stays cheap.
#
# Every block is guarded by <IfModule> so an unavailable module degrades to a
# no-op instead of taking the directory down.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|css|svg|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType image/svg+xml .svg
</IfModule>
